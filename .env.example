# Application
SITE_NAME="铁路记忆馆"
SITE_DESCRIPTION="面向铁路文化内容的开源资料馆与内容管理平台。"
SITE_URL="http://localhost:3000"

# Database
DATABASE_URL="postgresql://railway:replace-with-a-long-random-password@localhost:15432/railway?schema=public"
POSTGRES_USER="railway"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="railway"

# GuideAgent read-only database access
GUIDE_AGENT_READONLY_DB_USER="guide_agent_readonly"
GUIDE_AGENT_READONLY_DB_PASSWORD="replace-with-a-long-random-readonly-password"

# MinIO
MINIO_ROOT_USER="railway"
MINIO_ROOT_PASSWORD="replace-with-a-long-random-minio-password"
MINIO_API_PORT="19000"
MINIO_CONSOLE_PORT="19001"

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Admin bootstrap account
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-now"
ADMIN_DISPLAY_NAME="Administrator"

# Storage: local or s3
STORAGE_DRIVER="local"
LOCAL_MEDIA_DIR="./storage/media"

# S3/MinIO
S3_ENDPOINT="http://localhost:19000"
S3_REGION="us-east-1"
S3_BUCKET="railway-media"
S3_ACCESS_KEY_ID="railway"
S3_SECRET_ACCESS_KEY="replace-with-a-long-random-minio-password"
S3_FORCE_PATH_STYLE="true"

# GuideAgent agent integration
GUIDE_AGENT_EXPORT_TOKEN="replace-with-a-long-random-agent-export-token"
GUIDE_AGENT_WRITE_ADMIN_TOKEN="replace-with-a-long-random-agent-write-admin-token"
GUIDE_AGENT_ACCOUNT_SYNC_URL="http://guide-agent-core:8080"
GUIDE_AGENT_ACCOUNT_SYNC_TOKEN="replace-with-a-long-random-account-sync-token"
GUIDE_AGENT_WIDGET_ENABLED="false"
GUIDE_AGENT_PUBLIC_BASE_URL=""
NEXT_PUBLIC_GUIDE_AGENT_SITE_ID="default-site"
